                            <constraint firstItem="FeedSegmentedControl" firstAttribute="top" secondItem="HomeSafeArea" secondAttribute="top" constant="16" id="SegmentTopConstraint"/>
                            <constraint firstItem="HomeSafeArea" firstAttribute="trailing" secondItem="FeedSegmentedControl" secondAttribute="trailing" constant="16" id="SegmentTrailingConstraint"/>
