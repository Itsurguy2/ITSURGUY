                            <constraint firstItem="PostsTableView" firstAttribute="leading" secondItem="HomeSafeArea" secondAttribute="leading" id="TableLeadingConstraint"/>
                            <constraint firstItem="PostsTableView" firstAttribute="top" secondItem="FeedSegmentedControl" secondAttribute="bottom" constant="8" id="TableTopConstraint"/>
                            <constraint firstItem="HomeSafeArea" firstAttribute="trailing" secondItem="PostsTableView" secondAttribute="trailing" id="TableTrailingConstraint"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="ItsUrGuy" id="HomeNavItem">
